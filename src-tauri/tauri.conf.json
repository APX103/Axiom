{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiom",
  "version": "0.0.20",
  "identifier": "com.axiom-core.axiom",
  "build": {
    "beforeDevCommand": "cd ../frontend && bun run dev",
    "beforeBuildCommand": "true",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Axiom",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/axiom-backend": "axiom-backend"
    }
  }
}
